# Mac Mini over Tailscale. Include from ~/.ssh/config:
#   Include ~/.ssh/config.mini
#
# MagicDNS resolves the bare hostname; no IP needed. Tailscale SSH handles
# auth via tailnet identity, so no IdentityFile is required for this host.
# See vault: projects/project-machine-continuity.md

Host mini
    HostName mini
    User ldan
    # Survive brief network drops rather than hanging a tmux attach.
    ServerAliveInterval 20
    ServerAliveCountMax 3
    TCPKeepAlive yes
    # Reuse one connection for fast subsequent commands.
    ControlMaster auto
    ControlPath ~/.ssh/control-%r@%h:%p
    ControlPersist 10m
