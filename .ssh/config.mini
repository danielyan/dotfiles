# Mac Mini over Tailscale. Include from ~/.ssh/config:
#   Include ~/.ssh/config.mini
#
# MagicDNS resolves the bare hostname; no IP needed. Tailscale is only the
# network: the server is macOS's own sshd (Remote Login, with "Allow full disk
# access for remote users" on), not Tailscale SSH. Under Tailscale SSH every
# process was charged to tailscaled, so touching iCloud Drive or ~/Music raised
# a privacy dialog on the Mini's screen and blocked until someone clicked it.
# Auth is this machine's own key; only its public half is on the Mini.
# See vault: projects/project-machine-continuity.md

Host mini
    HostName mini
    User ldan
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    # The key's passphrase comes from the macOS Keychain, so non-interactive
    # calls (dev's checks run with BatchMode) work too. Homebrew's ssh does
    # not know UseKeychain; tell it to skip the line rather than fail.
    IgnoreUnknown UseKeychain
    UseKeychain yes
    AddKeysToAgent yes
    # Survive brief network drops rather than hanging a tmux attach.
    ServerAliveInterval 20
    ServerAliveCountMax 3
    TCPKeepAlive yes
    # Reuse one connection for fast subsequent commands.
    ControlMaster auto
    ControlPath ~/.ssh/control-%r@%h:%p
    ControlPersist 10m
