#!/usr/bin/env bash
# Provision a fresh Mac from nothing:
#
#   curl -L .../bin/mac-setup | bash
#   curl -L .../bin/mac-setup | bash -s -- --server     # the always-on Mini
#
# --server marks the machine with yadm's machine-local class before
# bootstrapping, since `yadm bootstrap` passes no arguments to the script.
set -euo pipefail

main() {
    export PATH="/opt/homebrew/bin:$PATH"

    if ! command -v brew >/dev/null 2>&1; then
        echo "Installing Homebrew"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        export PATH="/opt/homebrew/bin:$PATH"
    fi

    command -v yadm >/dev/null 2>&1 || brew install yadm gpg

    # Re-running on a machine that already has the dotfiles should not fail.
    if [ -d "$HOME/.local/share/yadm/repo.git" ]; then
        yadm pull --ff-only
    else
        yadm clone https://github.com/danielyan/dotfiles.git
    fi

    if [ "${1:-}" = "--server" ] && ! yadm config --get-all local.class 2>/dev/null | grep -qx server; then
        yadm config --add local.class server
    fi
    yadm bootstrap
}

# Piped into bash, this script IS bash's stdin, and everything it runs would
# inherit the pipe: the Homebrew installer cannot ask for a sudo password and
# refuses, and every prompt in bootstrap reads EOF, i.e. "no". So run main
# against the terminal. Only main is redirected: bash itself must keep
# reading the script from the pipe. With no terminal at all (CI), fall back
# to plain stdin, where prompts see EOF instead of hanging.
if (exec </dev/tty) 2>/dev/null; then
    main "$@" </dev/tty
else
    main "$@"
fi
