#!/usr/bin/env bash
# dev — control the always-on Mac Mini from anywhere.
#
# A shell-agnostic dispatcher: subcommands live in ~/.local/lib/dev/<name>.sh,
# each defining a `dev_<name>` function. Deliberately plain bash so it works
# over ssh, in any shell, and on a machine that has not been set up yet.
#
# See ~/README.md and vault: projects/project-machine-continuity.md

set -uo pipefail

DEV_HOST="${DEV_HOST:-mini}"
DEV_LIB="${DEV_LIB:-$HOME/.local/lib/dev}"
DEV_SESSION="${DEV_SESSION:-main}"
SYNCTHING_API="${SYNCTHING_API:-http://127.0.0.1:8384}"
export DEV_HOST DEV_LIB DEV_SESSION SYNCTHING_API

# --- output ---------------------------------------------------------------
if [ -t 1 ]; then
    C_OK=$'\033[32m'; C_NO=$'\033[31m'; C_WARN=$'\033[33m'
    C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
    C_OK=''; C_NO=''; C_WARN=''; C_BOLD=''; C_DIM=''; C_OFF=''
fi

ok()      { printf '  %s✓%s %s\n' "$C_OK" "$C_OFF" "$1"; }
no()      { printf '  %s✗%s %s\n' "$C_NO" "$C_OFF" "$1"
            [ $# -gt 1 ] && printf '      %s→ %s%s\n' "$C_DIM" "$2" "$C_OFF"; return 0; }
maybe()   { printf '  %s➞%s %s\n' "$C_WARN" "$C_OFF" "$1"
            [ $# -gt 1 ] && printf '      %s→ %s%s\n' "$C_DIM" "$2" "$C_OFF"; return 0; }
section() { printf '\n%s%s%s\n' "$C_BOLD" "$1" "$C_OFF"; }
die()     { printf '%sdev:%s %s\n' "$C_NO" "$C_OFF" "$1" >&2; exit 1; }

# Executables only: `command -v` also finds functions, and in verbose mode
# ssh, git and friends are logging functions, so a missing tool would pass.
have()    { type -P "$1" >/dev/null 2>&1; }

# Is this machine the always-on one? Nothing to connect to if so. Matches the
# `sleep` line exactly: /sleep/ first hit `displaysleep`, which the server
# config leaves at 10, so the Mini never recognised itself.
is_server() { [ "$(pmset -g 2>/dev/null | awk '$1 == "sleep" { print $2; exit }')" = "0" ]; }

# Reachability with a short timeout, so failures are fast and legible rather
# than a 30-second TCP hang.
reachable() { ssh -o ConnectTimeout=5 -o BatchMode=yes "$DEV_HOST" true 2>/dev/null; }

require_reachable() {
    reachable && return 0
    die "cannot reach '$DEV_HOST' — is Tailscale up and the Mini awake?"
}

# Run a bash command line on the Mini, in a login shell so Homebrew is on PATH.
#
# The command goes in on stdin, never as ssh arguments. ssh joins its arguments
# with spaces and the Mini's login shell splits the result again, so words
# passed separately are re-split there: `ssh mini bash -lc "syncthing cli
# show"` reached bash as `bash -lc syncthing`, a bare `syncthing`. Quoting for
# that shell is no fix either, because it is fish, whose single quotes treat
# backslashes differently from bash's — and %q output is full of them. The
# words `bash -ls` read the same in any shell.
remote_bash() {
    debug "sending to $DEV_HOST's bash: $1"
    printf '%s\n' "$1" | ssh -o BatchMode=yes "$DEV_HOST" 'bash -ls'
}

# Session names keep to letters, digits, _ and -, everything else becoming _.
# tmux reads "." and ":" in a target as window and pane separators, so
# "my.proj" could not reliably be found again; and the name crosses ssh (for
# mosh too) as a bare word the Mini's shell splits, so a space would not
# survive either.
session_name() { printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9_-' '_'; }

# --- verbose ---------------------------------------------------------------
# `dev -v <command>` (or DEV_VERBOSE=1): what dev decided and why, and every
# call it makes to another machine or service, on stderr so the normal output
# stays as it is. Secrets are masked: this output lands in terminals and
# transcripts, and those sync.
DEV_VERBOSE="${DEV_VERBOSE:-0}"
if [ -t 2 ]; then D_DIM=$'\033[2m'; D_OFF=$'\033[0m'; else D_DIM=''; D_OFF=''; fi
# Debug output gets its own copy of stderr: many calls silence theirs with
# 2>/dev/null, and a traced call's debug line would vanish with it.
exec 3>&2

debug() {
    [ "$DEV_VERBOSE" = 1 ] || return 0
    printf '%s[dev] %s%s\n' "$D_DIM" "$*" "$D_OFF" \
        | sed -E 's/(X-API-Key:(\\ | )?)[^ ]+/\1***/g; s/(<apikey>)[^<]*/\1***/g' >&3
}

# Log a command, run it, and log a failure. Only installed in verbose mode.
_trace() {
    local tool=$1; shift
    debug "\$ $tool $(printf '%q ' "$@")"
    command "$tool" "$@"
    local rc=$?
    [ "$rc" -eq 0 ] || debug "  ↳ $tool exited $rc"
    return "$rc"
}

export -f ok no maybe section die have is_server reachable require_reachable remote_bash session_name debug

# --- dispatch -------------------------------------------------------------
COMMANDS="connect doctor preflight land pair ls run shell status repos"

usage() {
    cat <<USAGE
${C_BOLD}dev${C_OFF} — control the always-on Mac Mini

  ${C_BOLD}dev${C_OFF}                     in ~/projects/<p>: the <p> session, started there;
                          anywhere else: the '$DEV_SESSION' session
  ${C_BOLD}dev${C_OFF} <name>              attach to, or create, the <name> session
  ${C_BOLD}dev connect${C_OFF} [name]      the same, spelled out (and for names that are commands)
  ${C_BOLD}dev ls${C_OFF}                  list sessions without attaching
  ${C_BOLD}dev run${C_OFF} <command>       run one command remotely, no session
  ${C_BOLD}dev shell${C_OFF}               a plain login shell, no tmux
  ${C_BOLD}dev status${C_OFF}              quick health summary
  ${C_BOLD}dev pair${C_OFF}                wire Syncthing to the Mini, both ends
  ${C_BOLD}dev doctor${C_OFF}              full check of every link, with remedies
  ${C_BOLD}dev preflight${C_OFF}           before going offline: pull everything down
  ${C_BOLD}dev land${C_OFF}                after coming back: push up, catch the Mini up
  ${C_BOLD}dev repos${C_OFF} [cmd]         the repos ~/projects should hold (dev repos help)
  ${C_BOLD}dev help${C_OFF}                this

  ${C_BOLD}dev -v${C_OFF} <command>      verbose: what dev decides and every remote call (DEV_VERBOSE=1)

Host is '$DEV_HOST'; override with \$DEV_HOST.
USAGE
}

# -v/--verbose only before the command: after it, arguments belong to the
# command (`dev run ls -v` is ls's -v).
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) DEV_VERBOSE=1; shift ;;
        *) break ;;
    esac
done
export DEV_VERBOSE

if [ "$DEV_VERBOSE" = 1 ]; then
    for _t in ssh curl gh tmux syncthing git; do
        eval "$_t() { _trace $_t \"\$@\"; }"
    done
    unset _t
    debug "dotfiles at $(command yadm log -1 --format='%h (%cr)' 2>/dev/null || echo unknown)"
    debug "host '$DEV_HOST' resolves to $(dscacheutil -q host -a name "$DEV_HOST" 2>/dev/null | awk '/^ip_address/ { print $2; exit }' || true)"
    _sleep=$(pmset -g 2>/dev/null | awk '$1 == "sleep" { print $2; exit }')
    if is_server; then
        debug "this machine is the server: pmset sleep is ${_sleep:-unknown}"
    else
        debug "this machine is a client: pmset sleep is ${_sleep:-unknown}, the server has 0"
    fi
    unset _sleep
fi

cmd="${1:-connect}"
[ $# -gt 0 ] && shift

case "$cmd" in
    -h|--help|help) usage; exit 0 ;;
esac

# The command closest to $1, if it is close enough to be a typo of it.
_near_command() {
    local c best="" best_d=99 d limit
    for c in $COMMANDS; do
        d=$(awk -v a="$1" -v b="$c" 'BEGIN {
            la = length(a); lb = length(b)
            for (i = 0; i <= la; i++) m[i, 0] = i
            for (j = 0; j <= lb; j++) m[0, j] = j
            for (i = 1; i <= la; i++) for (j = 1; j <= lb; j++) {
                x = m[i-1, j] + 1; y = m[i, j-1] + 1
                z = m[i-1, j-1] + (substr(a, i, 1) != substr(b, j, 1))
                m[i, j] = (x < y ? (x < z ? x : z) : (y < z ? y : z))
            }
            print m[la, lb] }')
        [ "$d" -lt "$best_d" ] && { best=$c; best_d=$d; }
    done
    # Short commands tolerate one slip, longer ones two.
    limit=2; [ ${#best} -le 4 ] && limit=1
    [ "$best_d" -le "$limit" ] && printf '%s' "$best"
}

_session_exists() {
    local target="=$(session_name "$1")"
    if is_server; then
        tmux has-session -t "$target" 2>/dev/null
    else
        ssh -o ConnectTimeout=5 -o BatchMode=yes "$DEV_HOST" tmux has-session -t "$target" 2>/dev/null
    fi
}

if ! printf '%s\n' $COMMANDS | grep -qx "$cmd"; then
    case "$cmd" in
        -*) die "unknown option '$cmd' (dev help)" ;;
    esac
    # Not a command, so a session: `dev magpie` is `dev connect magpie`. A
    # near-miss of a command is likelier a typo than a new session, so it
    # only counts as a session when one by that name already exists.
    near=$(_near_command "$cmd")
    if [ -n "$near" ]; then
        debug "'$cmd' is close to the command '$near': a session only if one by that name exists"
    else
        debug "'$cmd' is not a command, so it names a session"
    fi
    if [ -n "$near" ] && ! _session_exists "$cmd"; then
        die "'$cmd' is not a command or a session — did you mean 'dev $near'? (to start a session called '$cmd': dev connect $cmd)"
    fi
    set -- "$cmd" "$@"
    cmd=connect
fi

[ -f "$DEV_LIB/$cmd.sh" ] || die "missing $DEV_LIB/$cmd.sh (try: yadm pull)"
# shellcheck source=/dev/null
. "$DEV_LIB/$cmd.sh"
"dev_$cmd" "$@"
