#!/usr/bin/env bash
# preflight — prepare the Air for offline work.
#
# Under the remote-first model the Mini is the source of truth and the Air's
# copies are read-mostly. Run this before travelling: it pulls every repo under
# ~/projects and forces a Syncthing rescan so ~/.claude is current.
#
# Safe to re-run. Never commits, never pushes, never touches a dirty tree.
# See vault: projects/project-machine-continuity.md

set -uo pipefail

PROJECTS_DIR="${PROJECTS_DIR:-$HOME/projects}"
SYNCTHING_API="${SYNCTHING_API:-http://127.0.0.1:8384}"

ok()   { printf '\033[32m[✓]\033[0m %s\n' "$1"; }
err()  { printf '\033[31m[✗]\033[0m %s\n' "$1"; }
warn() { printf '\033[33m[➞]\033[0m %s\n' "$1"; }

clean=0; skipped=0; failed=0

echo "Pulling repos in $PROJECTS_DIR"
echo

for dir in "$PROJECTS_DIR"/*/; do
    [ -d "$dir/.git" ] || continue
    name=$(basename "$dir")

    if ! git -C "$dir" remote get-url origin >/dev/null 2>&1; then
        warn "$name — no remote, skipping"
        skipped=$((skipped + 1))
        continue
    fi

    # Refuse to touch a dirty tree; pulling could conflict or stash silently.
    if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
        warn "$name — uncommitted changes, skipping"
        skipped=$((skipped + 1))
        continue
    fi

    if out=$(git -C "$dir" pull --ff-only --quiet 2>&1); then
        ok "$name"
        clean=$((clean + 1))
    else
        err "$name — $out"
        failed=$((failed + 1))
    fi
done

echo
echo "Refreshing Claude state"

if ! command -v syncthing >/dev/null 2>&1; then
    warn "syncthing not installed — skipping rescan"
elif ! curl -sf -m 3 -o /dev/null "$SYNCTHING_API/rest/noauth/health"; then
    warn "syncthing not responding at $SYNCTHING_API — skipping rescan"
else
    apikey=$(sed -n 's:.*<apikey>\(.*\)</apikey>.*:\1:p' \
        "$HOME/Library/Application Support/Syncthing/config.xml" 2>/dev/null | head -1)
    if [ -z "$apikey" ]; then
        warn "could not read syncthing api key — skipping rescan"
    elif curl -sf -m 10 -o /dev/null -X POST \
            -H "X-API-Key: $apikey" "$SYNCTHING_API/rest/db/scan"; then
        ok "syncthing rescan triggered"
    else
        err "syncthing rescan failed"
    fi
fi

# Pin the Obsidian vault so iCloud cannot evict it while offline.
VAULT="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Notes"
if [ -d "$VAULT" ] && command -v brctl >/dev/null 2>&1; then
    brctl download "$VAULT" >/dev/null 2>&1 && ok "vault pinned locally" \
        || warn "vault pin failed"
fi

echo
echo "pulled:$clean  skipped:$skipped  failed:$failed"
[ "$failed" -eq 0 ]
