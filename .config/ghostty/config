font-family = "Iosevka Term"
font-size = 14
theme = Catppuccin Macchiato

background-opacity = 0.85
unfocused-split-opacity = 0.7
background-blur=16
#macos-titlebar-style = hidden
font-thicken=true
font-thicken-strength=1
adjust-cell-height=1
#scrollback-limit 10
term = xterm-256color



# Jump straight to the persistent tmux session on the Mini.
# See vault: projects/project-machine-continuity.md
keybind = cmd+shift+m=text:dev\n

# Shift+Enter as ESC+CR (Alt+Enter), which Claude Code reads as a newline.
# Over `dev` (mosh → tmux) the real Shift+Enter never arrives: mosh keeps the
# Mini's request for extended key reporting to itself, so Ghostty sends a bare
# CR, the same as Enter. ESC+CR is plain bytes and gets through mosh and tmux.
keybind = shift+enter=text:\x1b\r
