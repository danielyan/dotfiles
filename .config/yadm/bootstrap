#!/usr/bin/env bash
# yadm bootstrap — provision a Mac from scratch.
#
# Idempotent: safe to re-run at any time. Every step checks current state
# before acting.
#
#   bootstrap            provision a normal workstation
#   bootstrap --server   also apply always-on server config (the Mac Mini)
#
# See vault: projects/project-machine-continuity.md

set -uo pipefail

export PATH="/opt/homebrew/bin:$PATH"

SERVER_MODE=0
[ "${1:-}" = "--server" ] && SERVER_MODE=1

## Functions ###############################################
ask() {
    local prompt="${1:-Are you sure? Type 'y' or 'yes' to continue: }"
    local response
    read -r -p "$prompt" response
    response=$(echo "$response" | tr '[:upper:]' '[:lower:]')
    [[ "$response" == "y" || "$response" == "yes" ]]
}

command_exists() { command -v "$1" &>/dev/null; }

echo_ok()   { echo "[✓] $1"; }
echo_err()  { echo "[✗] $1"; }
echo_warn() { echo "[➞] $1"; }

# Bootstrap deliberately runs without `set -e`: one failed step should not
# abandon the rest of a provisioning run. The cost is that failures scroll past
# unnoticed, so anything needing a human is collected and reprinted at the end.
TODOS=()
todo() { TODOS+=("$1"); echo_err "$1"; }
############################################################

echo_ok "Bootstrap starting..."

## Apple updates ###########################################
if command_exists softwareupdate; then
    ask "Install apple updates? " && {
        sudo softwareupdate -i -a && echo_ok "Updates installed."
    }
else
    echo_warn "softwareupdate not available, skipping"
fi

## Homebrew ################################################
if ! command_exists brew; then
    echo_ok "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    export PATH="/opt/homebrew/bin:$PATH"
fi

echo_ok "Updating Homebrew..."
brew update
brew upgrade

echo_ok "Installing apps from Brewfile..."
brew bundle --file="$HOME/Brewfile"

## Secrets #################################################
# Plaintext secrets live only in yadm's encrypted archive; see
# .config/yadm/encrypt for the list. Decrypting prompts for the passphrase.
if [ -f "$HOME/.local/share/yadm/archive" ]; then
    if [ ! -f "$HOME/.config/magpie/api-keys.env" ]; then
        echo_ok "Decrypting yadm archive..."
        yadm decrypt || echo_warn "yadm decrypt failed; secrets stay missing"
    else
        echo_ok "Secrets already decrypted"
    fi
else
    echo_warn "No yadm archive found; skipping secrets"
fi

# MCP servers carry tokens, so they are stored apart from ~/.claude.json
# (which also holds Claude Code runtime state) and merged back in here.
MCP_SRC="$HOME/.config/claude/mcp-servers.json"
MCP_MERGE="$HOME/.local/lib/yadm/claude-mcp-merge.py"
if [ -f "$MCP_SRC" ] && [ -x "$MCP_MERGE" ]; then
    echo_ok "Syncing Claude MCP servers: $("$MCP_MERGE" "$MCP_SRC" "$HOME/.claude.json")"
fi

## Shell ###################################################
FISH_PATH="$(command -v fish || echo /opt/homebrew/bin/fish)"

if [ -x "$FISH_PATH" ]; then
    if ! grep -qxF "$FISH_PATH" /etc/shells; then
        echo_ok "Registering fish in /etc/shells..."
        echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null
    fi

    if [ "$SHELL" != "$FISH_PATH" ]; then
        echo_ok "Setting fish as the default shell..."
        chsh -s "$FISH_PATH"
    else
        echo_ok "fish is already the default shell"
    fi
else
    echo_err "fish not found, leaving shell unchanged"
fi

# Prompt theme and plugins (fisher is declarative via fish_plugins).
if [ -f "$HOME/.config/fish/fish_plugins" ] && command_exists fish; then
    echo_ok "Syncing fish plugins..."
    fish -c "fisher update" || echo_warn "fisher update failed"
    # fish_variables is untracked, so recreate the tide look declaratively.
    echo_ok "Configuring tide prompt..."
    fish -c "tide configure --auto --style=Classic --prompt_colors='True color' --classic_prompt_color=Light --show_time=No --classic_prompt_separators=Angled --powerline_prompt_heads=Sharp --powerline_prompt_tails=Flat --powerline_prompt_style='One line' --prompt_spacing=Compact --icons='Many icons' --transient=No" >/dev/null \
        || echo_warn "tide configure failed"
fi

## macOS defaults ##########################################
if [ -x "$HOME/bin/mac-defaults" ]; then
    ask "Set up macOS defaults? " && "$HOME/bin/mac-defaults"
fi

## Default applications ##################################
# Not part of mac-defaults: those are `defaults write` calls, while file-type
# bindings live in the LaunchServices database. Since macOS 26.4 each change
# needs a click on a confirmation dialog, so list what would change and ask
# first; on an already-configured Mac the check is silent and nothing prompts.
if [ -x "$HOME/bin/mac-default-apps" ]; then
    "$HOME/bin/mac-default-apps" --check
    case $? in
        0) ;;
        2) if ask "Apply these? macOS asks you to confirm each one: "; then
               "$HOME/bin/mac-default-apps" \
                   || todo "Some default apps were not set. Retry with: mac-default-apps"
           else
               todo "Default apps not applied. Run: mac-default-apps"
           fi ;;
        *) todo "Could not check default apps. Run: mac-default-apps --check" ;;
    esac
fi

## VSCode ##################################################
VSCODE_USER_DIR="$HOME/Library/Application Support/Code/User"
if [ -d "$(dirname "$VSCODE_USER_DIR")" ]; then
    mkdir -p "$VSCODE_USER_DIR"
    # mcp.json holds an API token, so it is decrypted from the archive rather
    # than tracked in the clear; link it only once it exists.
    for f in settings.json mcp.json; do
        [ -f "$HOME/.config/vscode/$f" ] || continue
        if [ ! -L "$VSCODE_USER_DIR/$f" ]; then
            # -f so re-running replaces a stale regular file rather than failing.
            ln -sf "$HOME/.config/vscode/$f" "$VSCODE_USER_DIR/$f"
            echo_ok "Linked VSCode $f"
        else
            echo_ok "VSCode $f already linked"
        fi
    done
fi

if command_exists code && [ -f "$HOME/.config/vscode/extensions" ]; then
    echo_ok "Installing VSCode extensions..."
    # --force makes already-installed extensions a no-op instead of an error.
    xargs -L 1 code --force --install-extension < "$HOME/.config/vscode/extensions"
fi

## SSH #####################################################
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
if [ -f "$HOME/.ssh/config.mini" ] && ! grep -q "config.mini" "$HOME/.ssh/config" 2>/dev/null; then
    # Include must come first: ssh takes the FIRST value it sees for any
    # keyword, so a later Host * block would otherwise win over the Mini's.
    tmp=$(mktemp)
    echo "Include ~/.ssh/config.mini" > "$tmp"
    echo "" >> "$tmp"
    [ -f "$HOME/.ssh/config" ] && cat "$HOME/.ssh/config" >> "$tmp"
    mv "$tmp" "$HOME/.ssh/config"
    chmod 600 "$HOME/.ssh/config"
    echo_ok "Wired ~/.ssh/config.mini into ~/.ssh/config"
fi

# Keys are per-machine and never synced. Generating the key and registering it
# with GitHub are separate steps on purpose: registering can fail on its own
# (missing gh scope, no network), and must still be retried by a later run even
# though the key file now exists.
HOSTLABEL="$(scutil --get LocalHostName 2>/dev/null || hostname)"

if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
    ask "Generate an SSH key for this machine? " && {
        ssh-keygen -t ed25519 -C "$(whoami)@$HOSTLABEL" -f "$HOME/.ssh/id_ed25519" \
            && echo_ok "Generated ~/.ssh/id_ed25519"
    }
fi

register_github_key() {
    local pub="$HOME/.ssh/id_ed25519.pub"
    [ -f "$pub" ] || return 0

    local manual="gh ssh-key add $pub -t $HOSTLABEL"

    if ! command_exists gh; then
        todo "Add this machine's SSH key to GitHub: $manual"
        return 0
    fi

    if ! gh auth status >/dev/null 2>&1; then
        echo_warn "gh is not logged in"
        ask "Log in to GitHub now? " && gh auth login
        gh auth status >/dev/null 2>&1 || { todo "Log in with 'gh auth login', then: $manual"; return 0; }
    fi

    # Already registered? Compare the key body, which is stable across renames.
    local body
    body=$(awk '{print $2}' "$pub")
    if gh ssh-key list 2>/dev/null | grep -qF "$body"; then
        echo_ok "SSH key already registered with GitHub"
        return 0
    fi

    # Uploading needs admin:public_key. A token without it fails with an API
    # error that is easy to miss in a long provisioning run.
    if ! gh auth status 2>&1 | grep -q 'admin:public_key'; then
        echo_warn "gh token lacks the admin:public_key scope"
        if ask "Request it now? "; then
            gh auth refresh -h github.com -s admin:public_key \
                || { todo "Grant the scope, then: $manual"; return 0; }
        else
            todo "Grant the scope with 'gh auth refresh -h github.com -s admin:public_key', then: $manual"
            return 0
        fi
    fi

    if gh ssh-key add "$pub" -t "$HOSTLABEL"; then
        echo_ok "Registered SSH key with GitHub as '$HOSTLABEL'"
    else
        todo "Registering the SSH key failed. Retry with: $manual"
    fi
}
register_github_key

## Syncthing ###############################################
if command_exists syncthing; then
    if ! brew services list | grep -q '^syncthing.*started'; then
        echo_ok "Starting syncthing..."
        brew services start syncthing
    else
        echo_ok "syncthing already running"
    fi
    # Pairing needs the other machine reachable over ssh, which bootstrap
    # cannot guarantee, so it is a separate explicit step.
    echo_warn "Once Tailscale is up and the Mini is reachable: mini pair"
fi

## Server mode (the always-on Mac Mini) ####################
if [ "$SERVER_MODE" -eq 1 ]; then
    echo_ok "Applying always-on server configuration..."

    # Never sleep; wake after power loss; allow background work while idle.
    sudo pmset -a sleep 0 disksleep 0 powernap 1
    sudo pmset -a autorestart 1 2>/dev/null || echo_warn "autorestart unsupported"
    echo_ok "Power management configured"

    # iCloud evicts files it thinks are cold. A headless service reading a
    # dataless placeholder fails, so pin the vault and keep it pinned.
    VAULT="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Notes"
    if [ -d "$VAULT" ]; then
        brctl download "$VAULT" >/dev/null 2>&1 && echo_ok "Vault pinned locally"
    else
        echo_warn "Vault not present yet — re-run once iCloud has synced"
    fi
    echo_warn "Manually enable: Settings > General > Sharing > Screen Sharing"
    echo_warn "Manually enable: Settings > Users & Groups > Automatic login"
fi

if [ "${#TODOS[@]}" -gt 0 ]; then
    echo
    echo_warn "Bootstrap finished, but ${#TODOS[@]} step(s) need you:"
    for t in "${TODOS[@]}"; do echo "    • $t"; done
    echo
    echo_warn "Re-running 'yadm bootstrap' will retry them."
    exit 1
fi

echo_ok "Bootstrap finished."
