#!/usr/bin/env bash
# yadm bootstrap — provision a Mac from scratch.
#
# Idempotent: safe to re-run at any time. Every step checks current state
# before acting.
#
#   yadm bootstrap       provision this Mac
#
# Server mode (the always-on Mac Mini) is a property of the machine, not of
# one run: mark it once with `yadm config local.class server` and every run
# applies the always-on config. Undo with `yadm config --unset local.class`.
# Running this script directly as `bootstrap --server` also sets the mark.
#
# See vault: projects/project-machine-continuity.md

set -uo pipefail

export PATH="/opt/homebrew/bin:$PATH"

# `yadm bootstrap` execs this script with no arguments, so a --server passed
# to it never arrived and server mode never ran; the machine-local class does
# not depend on how this was started. yadm keeps it in the local repo config,
# which is never pushed.
# A machine can carry several classes, so check the whole list.
server_mode() {
    command -v yadm >/dev/null 2>&1 || return 1
    if [ "${1:-}" = "--server" ] && ! yadm config --get-all local.class 2>/dev/null | grep -qx server; then
        yadm config --add local.class server
    fi
    yadm config --get-all local.class 2>/dev/null | grep -qx server
}

SERVER_MODE=0
server_mode "$@" && SERVER_MODE=1

## Functions ###############################################
ask() {
    local prompt="${1:-Are you sure? Type 'y' or 'yes' to continue: }"
    local response
    read -r -p "$prompt" response
    response=$(echo "$response" | tr '[:upper:]' '[:lower:]')
    [[ "$response" == "y" || "$response" == "yes" ]]
}

command_exists() { command -v "$1" &>/dev/null; }

echo_ok()   { echo "[✓] $1"; }
echo_err()  { echo "[✗] $1"; }
echo_warn() { echo "[➞] $1"; }

# Bootstrap deliberately runs without `set -e`: one failed step should not
# abandon the rest of a provisioning run. The cost is that failures scroll past
# unnoticed, so anything needing a human is collected and reprinted at the end.
TODOS=()
todo() { TODOS+=("$1"); echo_err "$1"; }
############################################################

# Touch ID for sudo, via sudo_local: /etc/pam.d/sudo includes it first, and
# macOS updates leave it alone. pam_reattach makes Touch ID work inside tmux;
# ignore_ssh skips it over ssh, where the sensor is on the other machine.
#
# pam_reattach is loaded by sudo as root, but Homebrew's copy sits in a
# directory this user owns, so anything running as this user could replace
# it. Load a root-owned copy instead, refreshed when Homebrew's changes.
#
# A PAM line naming a module that cannot load can break sudo outright, so a
# line is only written for a module confirmed present.
enable_touchid_sudo() {
    local pam_file="${1:-/etc/pam.d/sudo_local}"
    local tid="${2:-/usr/lib/pam/pam_tid.so.2}"
    local reattach_src="${3:-/opt/homebrew/lib/pam/pam_reattach.so}"
    local reattach="${4:-/usr/local/lib/pam/pam_reattach.so}"

    if [ ! -e "$tid" ]; then
        echo_warn "No Touch ID PAM module; leaving sudo alone"
        return 0
    fi

    if [ -f "$reattach_src" ] && ! cmp -s "$reattach_src" "$reattach"; then
        sudo install -d -o root -g wheel -m 755 "$(dirname "$reattach")" \
            && sudo install -o root -g wheel -m 444 "$reattach_src" "$reattach" \
            || todo "Copy pam_reattach for Touch ID in tmux: sudo install -o root -g wheel -m 444 $reattach_src $reattach"
    fi

    local want="# Managed by yadm bootstrap: Touch ID for sudo."
    [ -f "$reattach" ] && want+=$'\n'"auth       optional       $reattach ignore_ssh"
    want+=$'\n'"auth       sufficient     pam_tid.so"

    if [ "$(cat "$pam_file" 2>/dev/null)" = "$want" ]; then
        echo_ok "Touch ID for sudo already enabled"
        return 0
    fi
    [ -f "$pam_file" ] && sudo cp "$pam_file" "$pam_file.bak"
    if printf '%s\n' "$want" | sudo tee "$pam_file" >/dev/null; then
        echo_ok "Touch ID enabled for sudo"
    else
        todo "Enable Touch ID for sudo: write $pam_file (see bootstrap)"
    fi
}

# Paths listed in the yadm encrypt file that are not on disk, one per line.
# $1 = the encrypt list, $2 = the directory its paths are relative to.
missing_secrets() {
    local list="${1:-$HOME/.config/yadm/encrypt}" base="${2:-$HOME}" line
    [ -f "$list" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        [ -e "$base/$line" ] || printf '%s\n' "$line"
    done < "$list"
}

# Decrypt the yadm archive when secrets are missing.
#
# Every listed path is checked, not one sentinel file: a Mac set up before a
# path joined the list would otherwise never receive it. Decrypting restores
# *all* of them, overwriting what is on disk, so a fresh Mac (nothing there)
# decrypts straight away, while one missing only some asks first rather than
# replacing newer local copies with archived ones.
# $1 = the encrypt list, $2 = the directory its paths are relative to,
# $3 = the archive.
restore_secrets() {
    local list="${1:-$HOME/.config/yadm/encrypt}" base="${2:-$HOME}"
    local archive="${3:-$HOME/.local/share/yadm/archive}" missing total
    if [ ! -f "$archive" ]; then
        echo_warn "No yadm archive found; skipping secrets"
        return 0
    fi
    missing=$(missing_secrets "$list" "$base")
    total=$(grep -v -e '^#' -e '^[[:space:]]*$' "$list" | grep -c .)
    if [ -z "$missing" ]; then
        echo_ok "Secrets already decrypted"
    elif [ "$(printf '%s\n' "$missing" | grep -c .)" -eq "$total" ]; then
        echo_ok "Decrypting yadm archive..."
        yadm decrypt || echo_warn "yadm decrypt failed; secrets stay missing"
    else
        echo_warn "Secrets missing on this Mac:"
        printf '%s\n' "$missing" | sed 's/^/    /'
        if ask "Decrypt the archive? It also overwrites the other secret files with their archived copies: "; then
            yadm decrypt || todo "yadm decrypt failed; secrets still missing: $(printf '%s\n' "$missing" | paste -sd, -)"
        else
            todo "Missing secrets: $(printf '%s\n' "$missing" | paste -sd, -). Restore with: yadm decrypt (overwrites the others)"
        fi
    fi
}

# The always-on Mini's settings. Runs first thing in server mode: it used
# to be the last step, so any run that stopped early (a declined passphrase,
# Ctrl-C at a prompt) left the Mini sleeping after a minute and unreachable.
configure_server() {
    echo_ok "Applying always-on server configuration..."

    set_hostname mini

    # Never sleep; wake after power loss; allow background work while idle.
    sudo pmset -a sleep 0 disksleep 0 powernap 1
    sudo pmset -a autorestart 1 2>/dev/null || echo_warn "autorestart unsupported"
    # pmset exiting 0 is not the setting taking: read it back.
    if [ "$(pmset -g | awk '$1 == "sleep" { print $2; exit }')" = 0 ]; then
        echo_ok "Power management configured: never sleeps"
    else
        todo "The Mini still sleeps. Run: sudo pmset -a sleep 0 disksleep 0 powernap 1 autorestart 1"
    fi

    # iCloud evicts files it thinks are cold. A headless service reading a
    # dataless placeholder fails, so pin the vault and keep it pinned.
    local vault="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Notes"
    if [ -d "$vault" ]; then
        brctl download "$vault" >/dev/null 2>&1 && echo_ok "Vault pinned locally"
    else
        echo_warn "Vault not present yet — re-run once iCloud has synced"
    fi
}

# Tailscale's MagicDNS names a machine after its hostname when it first signs
# in, and ~/.ssh/config.mini and `dev` reach the server as plain "mini". So
# this has to run before Tailscale sign-in; renaming later does not rename the
# tailnet node.
set_hostname() {
    local want="$1" n current changed=0
    for n in ComputerName LocalHostName HostName; do
        current=$(scutil --get "$n" 2>/dev/null)
        [ "$current" = "$want" ] && continue
        if sudo scutil --set "$n" "$want"; then
            changed=1
        else
            todo "Set the $n: sudo scutil --set $n $want"
        fi
    done
    if [ "$changed" -eq 1 ]; then
        echo_ok "Hostname set to $want"
    else
        echo_ok "Hostname already $want"
    fi
}

# The Mini's tailscaled, from the formula the Brewfile gives a server. Started
# as root it is a LaunchDaemon, up before anyone logs in, so a reboot never
# waits on a login to be reachable; `brew services` without sudo would make it
# a per-user agent. Signing in stays a todo: it needs a browser.
start_tailscale_service() {
    local daemons="${LAUNCH_DAEMONS_DIR:-/Library/LaunchDaemons}"
    if ! command_exists tailscale; then
        todo "Tailscale is not installed. Run: brew bundle --file=~/Brewfile"
        return
    fi
    # brew names its service files sh.brew.*; before that, homebrew.mxcl.*.
    if [ -f "$daemons/sh.brew.tailscale.plist" ] || [ -f "$daemons/homebrew.mxcl.tailscale.plist" ]; then
        echo_ok "tailscaled already runs as a system service"
    elif sudo brew services start tailscale >/dev/null; then
        echo_ok "Started tailscaled as a system service"
    else
        todo "tailscaled is not running. Run: sudo brew services start tailscale"
        return
    fi
    tailscale status >/dev/null 2>&1 \
        || todo "Sign the Mini into Tailscale. Run: sudo tailscale up --ssh=false"
    # The Mini's own sshd serves ssh, not Tailscale SSH: see README, Layer 1.
    # Tailscale SSH only listens on the tailnet address, so a listener on
    # localhost:22 is Remote Login.
    nc -z -G 2 127.0.0.1 22 2>/dev/null \
        || todo "On the Mini: System Settings → General → Sharing → Remote Login on, ⓘ → Allow full disk access for remote users; add each client's public key to ~/.ssh/authorized_keys"
}

echo_ok "Bootstrap starting..."

[ "$SERVER_MODE" -eq 1 ] && configure_server

## Apple updates ###########################################
if command_exists softwareupdate; then
    ask "Install apple updates? " && {
        sudo softwareupdate -i -a && echo_ok "Updates installed."
    }
else
    echo_warn "softwareupdate not available, skipping"
fi

## Homebrew ################################################
if ! command_exists brew; then
    echo_ok "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    export PATH="/opt/homebrew/bin:$PATH"
fi

echo_ok "Updating Homebrew..."
brew update
brew upgrade

echo_ok "Installing apps from Brewfile..."
# A failed install would otherwise scroll past: bootstrap runs without set -e.
brew bundle --file="$HOME/Brewfile" \
    || todo "Some Brewfile entries did not install. Retry with: brew bundle --file=~/Brewfile"
[ "$SERVER_MODE" -eq 1 ] && start_tailscale_service

## Touch ID for sudo ########################################
enable_touchid_sudo

## Secrets #################################################
# Plaintext secrets live only in yadm's encrypted archive; see
# .config/yadm/encrypt for the list. Decrypting prompts for the passphrase.
restore_secrets

# MCP servers carry tokens, so they are stored apart from ~/.claude.json
# (which also holds Claude Code runtime state) and merged back in here.
MCP_SRC="$HOME/.config/claude/mcp-servers.json"
MCP_MERGE="$HOME/.local/lib/yadm/claude-mcp-merge.py"
if [ -f "$MCP_SRC" ] && [ -x "$MCP_MERGE" ]; then
    echo_ok "Syncing Claude MCP servers: $("$MCP_MERGE" "$MCP_SRC" "$HOME/.claude.json")"
fi

## Shell ###################################################
# The directory record, not $SHELL: $SHELL only changes at the next login,
# so a re-run in the same session would otherwise change it again.
set_login_shell() {
    local want="$1" current
    current=$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')
    if [ "$current" = "$want" ]; then
        echo_ok "fish is already the default shell"
        return 0
    fi
    echo_ok "Setting fish as the default shell..."
    # sudo rather than plain chsh: sudo was just used for /etc/shells, so it
    # is usually still authorised, while chsh asks for the account password
    # again and a typo used to fail with nothing recorded.
    sudo chsh -s "$want" "$USER" \
        || todo "Set fish as the login shell: sudo chsh -s $want $USER"
}

FISH_PATH="$(command -v fish || echo /opt/homebrew/bin/fish)"

if [ -x "$FISH_PATH" ]; then
    if ! grep -qxF "$FISH_PATH" /etc/shells; then
        echo_ok "Registering fish in /etc/shells..."
        echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null
    fi

    set_login_shell "$FISH_PATH"
else
    echo_err "fish not found, leaving shell unchanged"
fi

# Prompt theme and plugins (fisher is declarative via fish_plugins).
if [ -f "$HOME/.config/fish/fish_plugins" ] && command_exists fish; then
    echo_ok "Syncing fish plugins..."
    fish -c "fisher update" || echo_warn "fisher update failed"
    # fish_variables is untracked, so recreate the tide look declaratively.
    echo_ok "Configuring tide prompt..."
    fish -c "tide configure --auto --style=Classic --prompt_colors='True color' --classic_prompt_color=Light --show_time=No --classic_prompt_separators=Angled --powerline_prompt_heads=Sharp --powerline_prompt_tails=Flat --powerline_prompt_style='One line' --prompt_spacing=Compact --icons='Many icons' --transient=No" >/dev/null \
        || echo_warn "tide configure failed"
fi

## macOS defaults ##########################################
if [ -x "$HOME/bin/mac-defaults" ]; then
    ask "Set up macOS defaults? " && "$HOME/bin/mac-defaults"
fi

## Default applications ##################################
# Not part of mac-defaults: those are `defaults write` calls, while file-type
# bindings live in the LaunchServices database. Since macOS 26.4 each change
# needs a click on a confirmation dialog, so list what would change and ask
# first; on an already-configured Mac the check is silent and nothing prompts.
if [ -x "$HOME/bin/mac-default-apps" ]; then
    "$HOME/bin/mac-default-apps" --check
    case $? in
        0) ;;
        2) if ask "Apply these? macOS asks you to confirm each one: "; then
               "$HOME/bin/mac-default-apps" \
                   || todo "Some default apps were not set. Retry with: mac-default-apps"
           else
               todo "Default apps not applied. Run: mac-default-apps"
           fi ;;
        *) todo "Could not check default apps. Run: mac-default-apps --check" ;;
    esac
fi

## VSCode ##################################################
VSCODE_USER_DIR="$HOME/Library/Application Support/Code/User"
if [ -d "$(dirname "$VSCODE_USER_DIR")" ]; then
    mkdir -p "$VSCODE_USER_DIR"
    # mcp.json holds an API token, so it is decrypted from the archive rather
    # than tracked in the clear; link it only once it exists.
    for f in settings.json mcp.json; do
        [ -f "$HOME/.config/vscode/$f" ] || continue
        if [ ! -L "$VSCODE_USER_DIR/$f" ]; then
            # -f so re-running replaces a stale regular file rather than failing.
            ln -sf "$HOME/.config/vscode/$f" "$VSCODE_USER_DIR/$f"
            echo_ok "Linked VSCode $f"
        else
            echo_ok "VSCode $f already linked"
        fi
    done
fi

if command_exists code && [ -f "$HOME/.config/vscode/extensions" ]; then
    echo_ok "Installing VSCode extensions..."
    # --force makes already-installed extensions a no-op instead of an error.
    xargs -L 1 code --force --install-extension < "$HOME/.config/vscode/extensions"
fi

## SSH #####################################################
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
if [ -f "$HOME/.ssh/config.mini" ] && ! grep -q "config.mini" "$HOME/.ssh/config" 2>/dev/null; then
    # Include must come first: ssh takes the FIRST value it sees for any
    # keyword, so a later Host * block would otherwise win over the Mini's.
    tmp=$(mktemp)
    echo "Include ~/.ssh/config.mini" > "$tmp"
    echo "" >> "$tmp"
    [ -f "$HOME/.ssh/config" ] && cat "$HOME/.ssh/config" >> "$tmp"
    mv "$tmp" "$HOME/.ssh/config"
    chmod 600 "$HOME/.ssh/config"
    echo_ok "Wired ~/.ssh/config.mini into ~/.ssh/config"
fi

# Keys are per-machine and never synced. Generating the key and registering it
# with GitHub are separate steps on purpose: registering can fail on its own
# (missing gh scope, no network), and must still be retried by a later run even
# though the key file now exists.
HOSTLABEL="$(scutil --get LocalHostName 2>/dev/null || hostname)"

if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
    ask "Generate an SSH key for this machine? " && {
        ssh-keygen -t ed25519 -C "$(whoami)@$HOSTLABEL" -f "$HOME/.ssh/id_ed25519" \
            && echo_ok "Generated ~/.ssh/id_ed25519"
    }
fi

register_github_key() {
    local pub="$HOME/.ssh/id_ed25519.pub"
    [ -f "$pub" ] || return 0

    local manual="gh ssh-key add $pub -t $HOSTLABEL"

    if ! command_exists gh; then
        todo "Add this machine's SSH key to GitHub: $manual"
        return 0
    fi

    if ! gh auth status >/dev/null 2>&1; then
        echo_warn "gh is not logged in"
        ask "Log in to GitHub now? " && gh auth login
        gh auth status >/dev/null 2>&1 || { todo "Log in with 'gh auth login', then: $manual"; return 0; }
    fi

    # Already registered? Compare the key body, which is stable across renames.
    local body
    body=$(awk '{print $2}' "$pub")
    if gh ssh-key list 2>/dev/null | grep -qF "$body"; then
        echo_ok "SSH key already registered with GitHub"
        return 0
    fi

    # Uploading needs admin:public_key. A token without it fails with an API
    # error that is easy to miss in a long provisioning run.
    if ! gh auth status 2>&1 | grep -q 'admin:public_key'; then
        echo_warn "gh token lacks the admin:public_key scope"
        if ask "Request it now? "; then
            gh auth refresh -h github.com -s admin:public_key \
                || { todo "Grant the scope, then: $manual"; return 0; }
        else
            todo "Grant the scope with 'gh auth refresh -h github.com -s admin:public_key', then: $manual"
            return 0
        fi
    fi

    if gh ssh-key add "$pub" -t "$HOSTLABEL"; then
        echo_ok "Registered SSH key with GitHub as '$HOSTLABEL'"
    else
        todo "Registering the SSH key failed. Retry with: $manual"
    fi
}
register_github_key

## Projects ################################################
# After the GitHub login above: private repos need it. The list is one of the
# decrypted secrets, so a Mac without it yet has nothing to do here.
if [ -x "$HOME/bin/dev" ] && [ -f "$HOME/.config/dev/repos" ]; then
    echo_ok "Checking ~/projects against the repo list..."
    "$HOME/bin/dev" repos status
    case $? in
        0) ;;
        2) if ask "Clone the missing repos into ~/projects? "; then
               "$HOME/bin/dev" repos sync \
                   || todo "Some repos did not clone. Retry with: dev repos sync"
           else
               todo "Repos not cloned. Run: dev repos sync"
           fi ;;
        *) todo "Could not check the repo list. Run: dev repos status" ;;
    esac
fi

## Syncthing ###############################################
if command_exists syncthing; then
    if ! brew services list | grep -q '^syncthing.*started'; then
        echo_ok "Starting syncthing..."
        brew services start syncthing
    else
        echo_ok "syncthing already running"
    fi
    # Pairing needs the other machine reachable over ssh, which bootstrap
    # cannot guarantee, so it is a separate explicit step.
    echo_warn "Once Tailscale is up and the Mini is reachable: dev pair"
fi

## Server mode: what needs a person #########################
if [ "$SERVER_MODE" -eq 1 ]; then
    echo_warn "Manually enable: Settings > General > Sharing > Screen Sharing"
    echo_warn "Manually enable: Settings > Users & Groups > Automatic login"
fi

if [ "${#TODOS[@]}" -gt 0 ]; then
    echo
    echo_warn "Bootstrap finished, but ${#TODOS[@]} step(s) need you:"
    for t in "${TODOS[@]}"; do echo "    • $t"; done
    echo
    echo_warn "Re-running 'yadm bootstrap' will retry them."
    exit 1
fi

echo_ok "Bootstrap finished."
